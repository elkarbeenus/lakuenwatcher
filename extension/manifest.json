{
  "manifest_version": 3,
  "name": "LakuenWatcher",
  "short_name": "LakuenWatcher",
  "version": "0.1.0",
  "version_name": "0.1.0",
  "description": "Spielt automatisch die nächste Folge ab, wenn eine Folge zu Ende ist.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LakuenWatcher",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "alarms", "downloads"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/frame.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/profiles.js", "content/page.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
