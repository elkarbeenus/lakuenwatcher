{
  "manifest_version": 3,
  "name": "LakuenWatcher",
  "short_name": "LakuenWatcher",
  "version": "0.4.1",
  "version_name": "0.4.1",
  "description": "Spielt automatisch die nächste Folge ab, wenn eine Folge zu Ende ist.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LakuenWatcher",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "downloads",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/frame.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/profiles.js",
        "content/hosters.js",
        "content/page.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "next-episode": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Nächste Folge"
    },
    "skip-intro": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Intro überspringen"
    }
  }
}
